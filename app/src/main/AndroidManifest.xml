<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocoraLibrary">

        <!-- Main launcher: Demo Menu -->
        <activity
            android:name=".DemoMenuActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Original MainActivity kept for reference -->
        <activity android:name=".MainActivity" android:exported="false" />

        <!-- Showcase Activities -->
        <activity android:name=".ShowcaseActivity" android:exported="false" />
        <activity android:name=".ShapesShowcaseActivity" android:exported="false" />
        <activity android:name=".AnimationsShowcaseActivity" android:exported="false" />
        <activity android:name=".PositionsShowcaseActivity" android:exported="false" />
        <activity android:name=".ThemesShowcaseActivity" android:exported="false" />
        <activity android:name=".IndicatorsShowcaseActivity" android:exported="false" />

    </application>

</manifest>