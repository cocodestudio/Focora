<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#6200EE"
        android:text="Animation Styles"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap each button to see how the spotlight transitions"
        android:textColor="#888888"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp" />

    <!-- A target view all animations will highlight -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAnimTarget"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="#FFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Animation Target" android:textColor="#6200EE"
                android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="This card is highlighted by every animation" android:textColor="#888888"
                android:textSize="12sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/btnExpand"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="EXPAND  —  Spotlight grows from center outward"
                android:textAllCaps="false"
                android:backgroundTint="#6200EE"
                app:cornerRadius="999dp" />

            <Button
                android:id="@+id/btnFade"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="FADE  —  Alpha only, no size change"
                android:textAllCaps="false"
                android:backgroundTint="#03DAC5"
                android:textColor="#000000"
                app:cornerRadius="999dp" />

            <Button
                android:id="@+id/btnPulse"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="PULSE  —  Overshoot then snap back"
                android:textAllCaps="false"
                android:backgroundTint="#FF5722"
                app:cornerRadius="999dp" />

            <Button
                android:id="@+id/btnSlide"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="SLIDE  —  Slides in from previous position"
                android:textAllCaps="false"
                android:backgroundTint="#4CAF50"
                app:cornerRadius="999dp" />

            <Button
                android:id="@+id/btnNone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="NONE  —  Instant cut, no animation"
                android:textAllCaps="false"
                android:backgroundTint="#9E9E9E"
                app:cornerRadius="999dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
