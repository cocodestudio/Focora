<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#6200EE"
        android:text="Themes"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap to launch a tour with each theme"
        android:textColor="#888888"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp" />

    <!-- Target card that will be highlighted -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTarget"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="#FFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Theme Target" android:textColor="#6200EE"
                android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="This is the highlighted view" android:textColor="#888888"
                android:textSize="12sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <Button
            android:id="@+id/btnLightTheme"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="☀  Light Theme"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:backgroundTint="#FFFFFF"
            android:textColor="#6200EE"
            app:cornerRadius="999dp"
            app:strokeColor="#6200EE"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/btnDarkTheme"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="🌙  Dark Theme"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:backgroundTint="#1E1E1E"
            android:textColor="#BB86FC"
            app:cornerRadius="999dp" />

        <Button
            android:id="@+id/btnCustomTheme"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✨  Custom Theme  (Purple + Teal)"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF"
            app:cornerRadius="999dp" />

    </LinearLayout>

</LinearLayout>
