<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#6200EE"
        android:text="Spotlight Shapes"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap a button below to preview that shape's spotlight"
        android:textColor="#888888"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- CIRCLE shape target -->
    <ImageView
        android:id="@+id/ivCircleTarget"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="48dp"
        android:layout_marginStart="48dp"
        android:background="@android:drawable/sym_def_app_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHint" />

    <Button
        android:id="@+id/btnCircle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="CIRCLE"
        android:textAllCaps="false"
        android:backgroundTint="#6200EE"
        app:cornerRadius="20dp"
        app:layout_constraintTop_toTopOf="@id/ivCircleTarget"
        app:layout_constraintBottom_toBottomOf="@id/ivCircleTarget"
        app:layout_constraintStart_toEndOf="@id/ivCircleTarget" />

    <!-- ROUNDED_RECT shape target -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRectTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/ivCircleTarget">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Stats Card" android:textColor="#1A1A1A" android:textStyle="bold" android:textSize="15sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tap button →  to highlight with ROUNDED_RECT"
                android:textColor="#888888" android:textSize="12sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnRoundedRect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="ROUNDED_RECT"
        android:textAllCaps="false"
        android:backgroundTint="#03DAC5"
        android:textColor="#000000"
        app:cornerRadius="20dp"
        app:layout_constraintTop_toBottomOf="@id/cardRectTarget"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- PILL shape target -->
    <Button
        android:id="@+id/btnPillTarget"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:text="Upgrade to Pro"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:backgroundTint="#EDE7F6"
        android:textColor="#6200EE"
        android:textSize="16sp"
        app:cornerRadius="999dp"
        app:layout_constraintTop_toBottomOf="@id/btnRoundedRect" />

    <Button
        android:id="@+id/btnPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="PILL"
        android:textAllCaps="false"
        android:backgroundTint="#6200EE"
        app:cornerRadius="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnPillTarget"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- RECT shape target -->
    <ImageView
        android:id="@+id/ivRectTarget"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:background="#CCCCCC"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery"
        app:layout_constraintTop_toBottomOf="@id/btnPill" />

    <Button
        android:id="@+id/btnRect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="RECT"
        android:textAllCaps="false"
        android:backgroundTint="#FF5722"
        app:cornerRadius="20dp"
        app:layout_constraintTop_toBottomOf="@id/ivRectTarget"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
